                    <SelectItem value="mar-2025">March 2025</SelectItem>
                    <SelectItem value="q1-2024">Q1 (Apr-Jun 2024)</SelectItem>
                    <SelectItem value="q2-2024">Q2 (Jul-Sep 2024)</SelectItem>
                    <SelectItem value="q3-2024">Q3 (Oct-Dec 2024)</SelectItem>
                    <SelectItem value="q4-2025">Q4 (Jan-Mar 2025)</SelectItem>
                  </SelectContent>
                </Select>
              </div>
              <div className="space-y-2">
                <Label htmlFor="taxableAmount">Total Taxable Amount (₹)</Label>
                <Input
                  id="taxableAmount"
                  type="number"
                  placeholder="0.00"
                  value={filingData.taxableAmount}
                  onChange={(e) => updateField("taxableAmount", e.target.value)}
                />
              </div>
              <div className="space-y-2">
                <Label htmlFor="cgst">CGST (₹)</Label>
                <Input
                  id="cgst"
                  type="number"
                  placeholder="0.00"
                  value={filingData.cgst}
                  onChange={(e) => updateField("cgst", e.target.value)}
                />
              </div>
              <div className="space-y-2">
                <Label htmlFor="sgst">SGST/UTGST (₹)</Label>
                <Input
                  id="sgst"
                  type="number"
                  placeholder="0.00"
                  value={filingData.sgst}
                  onChange={(e) => updateField("sgst", e.target.value)}
                />
              </div>
              <div className="space-y-2">
                <Label htmlFor="igst">IGST (₹)</Label>
                <Input
                  id="igst"
                  type="number"
                  placeholder="0.00"
                  value={filingData.igst}
                  onChange={(e) => updateField("igst", e.target.value)}
                />
              </div>
              <div className="space-y-2">
                <Label htmlFor="cess">Cess (₹)</Label>
                <Input
                  id="cess"
                  type="number"
                  placeholder="0.00"
                  value={filingData.cess}
                  onChange={(e) => updateField("cess", e.target.value)}
                />
              </div>
              <div className="space-y-2">
                <Label htmlFor="itc">Input Tax Credit Claimed (₹)</Label>
                <Input
                  id="itc"
                  type="number"
                  placeholder="0.00"
                  value={filingData.itcClaimed}
                  onChange={(e) => updateField("itcClaimed", e.target.value)}
                />
              </div>
            </div>

            {/* Tax Summary */}
            <div className="p-4 bg-blue-50 dark:bg-blue-950 rounded-lg">
              <h4 className="font-semibold mb-2">Tax Summary</h4>
              <div className="grid grid-cols-3 gap-4 text-sm">
                <div>
                  <p className="text-muted-foreground">Total Tax</p>
                  <p className="font-bold text-lg">₹{calculateTotal().totalTax.toLocaleString()}</p>
                </div>
                <div>
                  <p className="text-muted-foreground">ITC Claimed</p>
                  <p className="font-bold text-lg text-blue-600">₹{calculateTotal().itc.toLocaleString()}</p>
                </div>
                <div>
                  <p className="text-muted-foreground">Net Payable</p>
                  <p className="font-bold text-lg text-green-600">₹{calculateTotal().netPayable.toLocaleString()}</p>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* Step 4: Supply Details */}
        {step === 4 && (
          <div className="space-y-4">
            <h3 className="text-lg font-semibold">Supply Details</h3>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div className="space-y-2">
                <Label htmlFor="outward">Total Outward Supplies (₹)</Label>
                <Input
                  id="outward"
                  type="number"
                  placeholder="0.00"
                  value={filingData.totalOutwardSupply}
                  onChange={(e) => updateField("totalOutwardSupply", e.target.value)}
                />
              </div>
              <div className="space-y-2">
                <Label htmlFor="inward">Total Inward Supplies (₹)</Label>
                <Input
                  id="inward"
                  type="number"
                  placeholder="0.00"
                  value={filingData.totalInwardSupply}
                  onChange={(e) => updateField("totalInwardSupply", e.target.value)}
                />
              </div>
              <div className="space-y-2">
                <Label htmlFor="exempt">Exempted Supplies (₹)</Label>
                <Input
                  id="exempt"
                  type="number"
                  placeholder="0.00"
                  value={filingData.exemptedSupply}
                  onChange={(e) => updateField("exemptedSupply", e.target.value)}
                />
              </div>
              <div className="space-y-2">
                <Label htmlFor="nilRated">Nil-Rated Supplies (₹)</Label>
                <Input
                  id="nilRated"
                  type="number"
                  placeholder="0.00"
                  value={filingData.nilRatedSupply}
                  onChange={(e) => updateField("nilRatedSupply", e.target.value)}
                />
              </div>
              <div className="space-y-2 md:col-span-2">
                <Label htmlFor="reverseCharge">Inward Supplies under Reverse Charge (₹)</Label>
                <Input
                  id="reverseCharge"
                  type="number"
                  placeholder="0.00"
                  value={filingData.reverseChargeInward}
                  onChange={(e) => updateField("reverseChargeInward", e.target.value)}
                />
              </div>
              <div className="space-y-2 md:col-span-2">
                <Label htmlFor="remarks">Additional Remarks</Label>
                <Textarea
                  id="remarks"
                  placeholder="Any additional information..."
                  value={filingData.remarks}
                  onChange={(e) => updateField("remarks", e.target.value)}
                />
              </div>
            </div>
          </div>
        )}

        {/* Step 5: Review */}
        {step === 5 && (
          <div className="space-y-4">
            <h3 className="text-lg font-semibold">Review & Submit</h3>

            <div className="space-y-4">
              {/* Business Info Summary */}
              <div className="p-4 border rounded-lg">
                <h4 className="font-semibold mb-2 flex items-center gap-2">
                  <Building2 className="h-4 w-4" /> Business Information
                </h4>
                <div className="grid grid-cols-2 md:grid-cols-3 gap-3 text-sm">
                  <div><span className="text-muted-foreground">Name:</span> <br /><strong>{filingData.businessName || "—"}</strong></div>
                  <div><span className="text-muted-foreground">GSTIN:</span> <br /><strong>{filingData.gstin || "—"}</strong></div>
                  <div><span className="text-muted-foreground">PAN:</span> <br /><strong>{filingData.pan || "—"}</strong></div>
                  <div><span className="text-muted-foreground">Type:</span> <br /><strong>{filingData.businessType || "—"}</strong></div>
                  <div><span className="text-muted-foreground">Registration:</span> <br /><strong>{filingData.registrationType || "—"}</strong></div>
                  <div><span className="text-muted-foreground">Tax Period:</span> <br /><strong>{filingData.taxPeriod || "—"}</strong></div>
                </div>
              </div>

              {/* Tax Summary */}
              <div className="p-4 border rounded-lg bg-green-50 dark:bg-green-950">
                <h4 className="font-semibold mb-2 flex items-center gap-2">
                  <IndianRupee className="h-4 w-4" /> Tax Summary
                </h4>
                <div className="grid grid-cols-2 md:grid-cols-4 gap-3 text-sm">
                  <div><span className="text-muted-foreground">CGST:</span> <br /><strong>₹{parseFloat(filingData.cgst || "0").toLocaleString()}</strong></div>
                  <div><span className="text-muted-foreground">SGST:</span> <br /><strong>₹{parseFloat(filingData.sgst || "0").toLocaleString()}</strong></div>
                  <div><span className="text-muted-foreground">IGST:</span> <br /><strong>₹{parseFloat(filingData.igst || "0").toLocaleString()}</strong></div>
                  <div><span className="text-muted-foreground">Cess:</span> <br /><strong>₹{parseFloat(filingData.cess || "0").toLocaleString()}</strong></div>
                </div>
                <Separator className="my-3" />
                <div className="grid grid-cols-3 gap-3">
                  <div>
                    <span className="text-sm text-muted-foreground">Total Tax</span>
                    <p className="font-bold text-xl">₹{calculateTotal().totalTax.toLocaleString()}</p>
                  </div>
                  <div>
                    <span className="text-sm text-muted-foreground">ITC Claimed</span>
                    <p className="font-bold text-xl text-blue-600">₹{calculateTotal().itc.toLocaleString()}</p>
                  </div>
                  <div>
                    <span className="text-sm text-muted-foreground">Net Payable</span>
                    <p className="font-bold text-xl text-green-700">₹{calculateTotal().netPayable.toLocaleString()}</p>
                  </div>
                </div>
              </div>

              {/* Declaration */}
              <div className="flex items-start space-x-3 p-4 border-2 border-orange-200 bg-orange-50 dark:bg-orange-950 rounded-lg">
                <Checkbox
                  id="declaration"
                  checked={filingData.declaration}
                  onCheckedChange={(checked) => updateField("declaration", checked === true)}
                />
                <Label htmlFor="declaration" className="text-sm cursor-pointer leading-relaxed">
                  I hereby declare that the information furnished above is true, correct and complete to the best of my knowledge and belief, and nothing has been concealed therefrom. I am aware that this is a demo application and actual GST filing should be done through the official GST portal (www.gst.gov.in).
                </Label>
              </div>
            </div>
          </div>
        )}
      </CardContent>

      <CardFooter className="flex justify-between">
        <Button
          variant="outline"
          onClick={() => setStep(Math.max(1, step - 1))}
          disabled={step === 1}
        >
          <ArrowLeft className="mr-2 h-4 w-4" />
          Previous
        </Button>

        {step < 5 ? (
          <Button onClick={() => setStep(Math.min(5, step + 1))}>
            Next
            <ArrowRight className="ml-2 h-4 w-4" />
          </Button>
        ) : (
          <Button
            onClick={handleSubmit}
            disabled={!filingData.declaration}
            className="bg-green-600 hover:bg-green-700"
          >
            <Send className="mr-2 h-4 w-4" />
            Submit GST Return
          </Button>
        )}
      </CardFooter>
    </Card>
  )
}

