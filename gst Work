// --- Composition Scheme Eligibility Checker ---
function CompositionEligibility() {
  const [formData, setFormData] = useState({
    annualTurnover: "",
    businessType: "",
    state: "",
    isInterStateSupply: false,
    isEcomOperator: false,
    isManufacturer: false,
    isServiceProvider: false,
    isIceCreamManufacturer: false,
    isTobaccoManufacturer: false,
    isPanMasalaManufacturer: false,
    hasMultipleStates: false,
    isNonResident: false,
    isCasualTaxable: false,
    isInputServiceDistributor: false,
  })
  const [result, setResult] = useState<null | { eligible: boolean; reasons: string[]; taxRate: string; suggestions: string[] }>(null)

  const checkEligibility = () => {
    const reasons: string[] = []
    const suggestions: string[] = []
    let eligible = true
    const turnover = parseFloat(formData.annualTurnover)

    // Turnover check
    if (isNaN(turnover)) {
      reasons.push("Please enter a valid annual turnover amount.")
      eligible = false
    } else {
      const isSpecialState = ["Arunachal Pradesh", "Assam", "Manipur", "Meghalaya", "Mizoram", "Nagaland", "Sikkim", "Tripura", "Himachal Pradesh", "Uttarakhand"].includes(formData.state)
      const limit = isSpecialState ? 75 : 150

      if (turnover > limit) {
        reasons.push(`Annual turnover exceeds ₹${limit} Lakhs (limit for ${isSpecialState ? "Special Category" : "General"} States).`)
        eligible = false
      }
    }

    // Business type check
    if (!formData.businessType) {
      reasons.push("Please select your business type.")
      eligible = false
    }

    // State check
    if (!formData.state) {
      reasons.push("Please select your state.")
      eligible = false
    }

    // Restriction checks
    if (formData.isInterStateSupply) {
      reasons.push("Businesses making inter-state outward supplies cannot opt for Composition Scheme.")
      eligible = false
    }
    if (formData.isEcomOperator) {
      reasons.push("Suppliers through e-commerce operators are not eligible.")
      eligible = false
    }
    if (formData.isIceCreamManufacturer) {
      reasons.push("Manufacturers of ice cream, pan masala, or tobacco are not eligible.")
      eligible = false
    }
    if (formData.isTobaccoManufacturer) {
      reasons.push("Tobacco product manufacturers are not eligible.")
      eligible = false
    }
    if (formData.isPanMasalaManufacturer) {
      reasons.push("Pan masala manufacturers are not eligible.")
      eligible = false
    }
    if (formData.isNonResident) {
      reasons.push("Non-resident taxable persons cannot opt for Composition Scheme.")
      eligible = false
    }
    if (formData.isCasualTaxable) {
      reasons.push("Casual taxable persons are not eligible.")
      eligible = false
    }
    if (formData.isInputServiceDistributor) {
      reasons.push("Input Service Distributors cannot opt for Composition Scheme.")
      eligible = false
    }

    // Tax rate determination
    let taxRate = ""
    if (eligible) {
      if (formData.businessType === "manufacturer") {
        taxRate = "1% CGST + 1% SGST (Total 2%)"
      } else if (formData.businessType === "restaurant") {
        taxRate = "2.5% CGST + 2.5% SGST (Total 5%)"
      } else if (formData.businessType === "trader") {
        taxRate = "0.5% CGST + 0.5% SGST (Total 1%)"
      } else if (formData.businessType === "service") {
        taxRate = "3% CGST + 3% SGST (Total 6%) — under Notification No. 2/2019"
      }
      suggestions.push("You can file GST returns quarterly using Form CMP-08.")
      suggestions.push("Annual return must be filed using GSTR-4 by 30th April.")
      suggestions.push("You cannot collect tax from customers under Composition Scheme.")
      suggestions.push("Input Tax Credit (ITC) cannot be claimed under this scheme.")
      suggestions.push("All invoices must carry 'Composition taxable person, not eligible to collect tax on supplies' as a heading.")
    } else {
      suggestions.push("Consider filing regular GST returns using GSTR-1 and GSTR-3B.")
      suggestions.push("Under regular scheme, you can claim Input Tax Credit (ITC).")
      suggestions.push("You can charge GST to customers and issue tax invoices.")
    }

    setResult({ eligible, reasons, taxRate, suggestions })
  }

  const specialStates = ["Arunachal Pradesh", "Assam", "Manipur", "Meghalaya", "Mizoram", "Nagaland", "Sikkim", "Tripura", "Himachal Pradesh", "Uttarakhand"]
  const allStates = [
    "Andhra Pradesh", "Arunachal Pradesh", "Assam", "Bihar", "Chhattisgarh", "Goa", "Gujarat",
    "Haryana", "Himachal Pradesh", "Jharkhand", "Karnataka", "Kerala", "Madhya Pradesh",
    "Maharashtra", "Manipur", "Meghalaya", "Mizoram", "Nagaland", "Odisha", "Punjab",
    "Rajasthan", "Sikkim", "Tamil Nadu", "Telangana", "Tripura", "Uttar Pradesh",
    "Uttarakhand", "West Bengal", "Delhi", "Jammu & Kashmir", "Ladakh", "Puducherry",
    "Chandigarh", "Andaman & Nicobar Islands", "Dadra & Nagar Haveli and Daman & Diu", "Lakshadweep"
  ]

  return (
    <div className="space-y-6">
      <Card>
        <CardHeader>
          <CardTitle className="flex items-center gap-2">
            <Shield className="h-5 w-5 text-blue-600" />
            GST Composition Scheme Eligibility Checker
          </CardTitle>
          <CardDescription>
            Check if your business qualifies for the GST Composition Scheme under Section 10 of the CGST Act, 2017
          </CardDescription>
        </CardHeader>
        <CardContent className="space-y-6">
          {/* Business Details */}
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div className="space-y-2">
              <Label htmlFor="turnover" className="flex items-center gap-1">
                <IndianRupee className="h-4 w-4" />
                Annual Aggregate Turnover (in Lakhs ₹)
              </Label>
              <Input
                id="turnover"
                type="number"
                placeholder="e.g., 50"
                value={formData.annualTurnover}
                onChange={(e) => setFormData({ ...formData, annualTurnover: e.target.value })}
              />
              <p className="text-xs text-muted-foreground">
                Limit: ₹1.5 Cr (General) / ₹75 L (Special Category States)
              </p>
            </div>

            <div className="space-y-2">
              <Label>Business Type</Label>
              <Select
                value={formData.businessType}
                onValueChange={(value) => setFormData({ ...formData, businessType: value })}
              >
                <SelectTrigger>
                  <SelectValue placeholder="Select business type" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="manufacturer">Manufacturer</SelectItem>
                  <SelectItem value="trader">Trader / Dealer</SelectItem>
                  <SelectItem value="restaurant">Restaurant (not serving alcohol)</SelectItem>
                  <SelectItem value="service">Service Provider</SelectItem>
                </SelectContent>
              </Select>
            </div>

            <div className="space-y-2">
              <Label>State / Union Territory</Label>
              <Select
                value={formData.state}
                onValueChange={(value) => setFormData({ ...formData, state: value })}
              >
                <SelectTrigger>
                  <SelectValue placeholder="Select state" />
                </SelectTrigger>
                <SelectContent>
                  {allStates.map((state) => (
                    <SelectItem key={state} value={state}>
                      {state} {specialStates.includes(state) ? "⭐" : ""}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
              <p className="text-xs text-muted-foreground">⭐ = Special Category State (lower turnover limit)</p>
            </div>
          </div>

          <Separator />

          {/* Restriction Questions */}
          <div>
            <h3 className="font-semibold mb-4 text-lg">Eligibility Conditions</h3>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              {[
                { key: "isInterStateSupply", label: "Do you make inter-state outward supplies?" },
                { key: "isEcomOperator", label: "Do you supply goods through e-commerce operators?" },
                { key: "isIceCreamManufacturer", label: "Do you manufacture ice cream?" },
                { key: "isTobaccoManufacturer", label: "Do you manufacture tobacco products?" },
                { key: "isPanMasalaManufacturer", label: "Do you manufacture pan masala?" },
                { key: "isNonResident", label: "Are you a non-resident taxable person?" },
                { key: "isCasualTaxable", label: "Are you a casual taxable person?" },
                { key: "isInputServiceDistributor", label: "Are you an Input Service Distributor?" },
              ].map((item) => (
                <div key={item.key} className="flex items-start space-x-3 p-3 rounded-lg border bg-gray-50 dark:bg-gray-900">
                  <Checkbox
                    id={item.key}
                    checked={formData[item.key as keyof typeof formData] as boolean}
                    onCheckedChange={(checked) =>
                      setFormData({ ...formData, [item.key]: checked === true })
                    }
                  />
                  <Label htmlFor={item.key} className="text-sm cursor-pointer leading-relaxed">
                    {item.label}
                  </Label>
                </div>
              ))}
            </div>
          </div>

          <Button onClick={checkEligibility} className="w-full" size="lg">
            <HelpCircle className="mr-2 h-5 w-5" />
            Check Eligibility
          </Button>
        </CardContent>
      </Card>

      {/* Result */}
      {result && (
        <Card className={`border-2 ${result.eligible ? "border-green-500" : "border-red-500"}`}>
          <CardHeader>
            <CardTitle className="flex items-center gap-2">
              {result.eligible ? (
                <>
                  <CheckCircle2 className="h-6 w-6 text-green-600" />
                  <span className="text-green-700">Eligible for Composition Scheme</span>
                </>
              ) : (
                <>
                  <XCircle className="h-6 w-6 text-red-600" />
                  <span className="text-red-700">Not Eligible for Composition Scheme</span>
                </>
              )}
            </CardTitle>
          </CardHeader>
          <CardContent className="space-y-4">
            {result.eligible && result.taxRate && (
              <Alert className="border-green-200 bg-green-50">
                <IndianRupee className="h-4 w-4" />
                <AlertTitle>Applicable Tax Rate</AlertTitle>
                <AlertDescription className="font-semibold text-lg">{result.taxRate}</AlertDescription>
              </Alert>
            )}

            {!result.eligible && result.reasons.length > 0 && (
              <div>
                <h4 className="font-semibold mb-2 text-red-700">Reasons for Ineligibility:</h4>
                <ul className="space-y-2">
                  {result.reasons.map((reason, i) => (
                    <li key={i} className="flex items-start gap-2 text-sm">
                      <XCircle className="h-4 w-4 text-red-500 mt-0.5 shrink-0" />
                      {reason}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <Separator />

            <div>
              <h4 className="font-semibold mb-2 flex items-center gap-2">
                <Info className="h-4 w-4 text-blue-600" />
                Recommendations:
              </h4>
              <ul className="space-y-2">
                {result.suggestions.map((suggestion, i) => (
                  <li key={i} className="flex items-start gap-2 text-sm">
                    <CheckCircle2 className="h-4 w-4 text-blue-500 mt-0.5 shrink-0" />
                    {suggestion}
                  </li>
                ))}
              </ul>
            </div>
          </CardContent>
        </Card>
      )}
    </div>
  )
}

// --- GST Filing Form ---
function GSTFilingForm() {
  const [step, setStep] = useState(1)
  const [submitted, setSubmitted] = useState(false)
  const [filingData, setFilingData] = useState({
    // Step 1: Business Info
    businessName: "",
    gstin: "",
    pan: "",
    businessType: "",
    registrationType: "",
    dateOfRegistration: "",
    // Step 2: Contact
    address: "",
    city: "",
    state: "",
    pincode: "",
    email: "",
    phone: "",
    // Step 3: Tax Details
    taxPeriod: "",
    taxableAmount: "",
    cgst: "",
    sgst: "",
    igst: "",
    cess: "",
    itcClaimed: "",
    // Step 4: Supply Details
    totalOutwardSupply: "",
    totalInwardSupply: "",
    exemptedSupply: "",
    nilRatedSupply: "",
    reverseChargeInward: "",
    // Additional
    remarks: "",
    declaration: false,
  })

  const updateField = (field: string, value: string | boolean) => {
    setFilingData({ ...filingData, [field]: value })
  }

  const calculateTotal = () => {
    const cgst = parseFloat(filingData.cgst) || 0
    const sgst = parseFloat(filingData.sgst) || 0
    const igst = parseFloat(filingData.igst) || 0
    const cess = parseFloat(filingData.cess) || 0
    const itc = parseFloat(filingData.itcClaimed) || 0
    return {
      totalTax: cgst + sgst + igst + cess,
      netPayable: Math.max(0, cgst + sgst + igst + cess - itc),
      itc,
    }
  }

  const handleSubmit = () => {
    setSubmitted(true)
  }

  if (submitted) {
    const totals = calculateTotal()
    return (
      <Card className="border-2 border-green-500">
        <CardHeader className="text-center">
          <CheckCircle2 className="h-16 w-16 text-green-600 mx-auto mb-4" />
          <CardTitle className="text-2xl text-green-700">GST Return Filed Successfully!</CardTitle>
          <CardDescription>Your GST return has been submitted for processing</CardDescription>
        </CardHeader>
        <CardContent className="space-y-4">
          <div className="grid grid-cols-2 gap-4 p-4 bg-gray-50 dark:bg-gray-900 rounded-lg">
            <div>
              <p className="text-sm text-muted-foreground">Business Name</p>
              <p className="font-semibold">{filingData.businessName || "N/A"}</p>
            </div>
            <div>
              <p className="text-sm text-muted-foreground">GSTIN</p>
              <p className="font-semibold">{filingData.gstin || "N/A"}</p>
            </div>
            <div>
              <p className="text-sm text-muted-foreground">Tax Period</p>
              <p className="font-semibold">{filingData.taxPeriod || "N/A"}</p>
            </div>
            <div>
              <p className="text-sm text-muted-foreground">Filing Reference</p>
              <p className="font-semibold">GST{Date.now().toString().slice(-10)}</p>
            </div>
            <div>
              <p className="text-sm text-muted-foreground">Total Tax Liability</p>
              <p className="font-semibold text-lg">₹{totals.totalTax.toLocaleString()}</p>
            </div>
            <div>
              <p className="text-sm text-muted-foreground">Net Tax Payable (after ITC)</p>
              <p className="font-semibold text-lg text-green-700">₹{totals.netPayable.toLocaleString()}</p>
            </div>
          </div>

          <Alert>
            <AlertTriangle className="h-4 w-4" />
            <AlertTitle>Important</AlertTitle>
            <AlertDescription>
              This is a demo filing. For actual GST filing, please visit the official GST portal at{" "}
              <a href="https://www.gst.gov.in" target="_blank" rel="noopener noreferrer" className="text-blue-600 underline">
                www.gst.gov.in
              </a>
            </AlertDescription>
          </Alert>

          <div className="flex gap-4">
            <Button variant="outline" className="flex-1" onClick={() => { setSubmitted(false); setStep(1) }}>
              <ArrowLeft className="mr-2 h-4 w-4" />
              File Another Return
            </Button>
            <Button className="flex-1">
              <Download className="mr-2 h-4 w-4" />
              Download Receipt
            </Button>
          </div>
        </CardContent>
      </Card>
    )
  }

  return (
    <Card>
      <CardHeader>
        <CardTitle className="flex items-center gap-2">
          <FileText className="h-5 w-5 text-blue-600" />
          GST Return Filing
        </CardTitle>
        <CardDescription>Complete all steps to file your GST return</CardDescription>

        {/* Progress Steps */}
        <div className="flex items-center justify-between mt-4">
          {[
            { num: 1, label: "Business Info" },
